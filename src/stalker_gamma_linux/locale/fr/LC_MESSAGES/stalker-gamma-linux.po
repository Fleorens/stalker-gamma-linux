msgstr "Rapport"

msgid "Proton builds installed"
msgstr "Builds Proton installés"

msgid "GAMMA detected on disk"
msgstr "GAMMA détecté sur le disque"

msgid "yes"
msgstr "oui"

msgid "no"
msgstr "non"

